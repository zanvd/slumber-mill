{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "overseer",
  "env": {
    "GH_CONFIG_DIR": "/nonexistent",
    "GIT_AUTHOR_NAME": "zanvd-claude[bot]",
    "GIT_AUTHOR_EMAIL": "341338700+zanvd-claude[bot]@users.noreply.github.com",
    "GIT_COMMITTER_NAME": "zanvd-claude[bot]",
    "GIT_COMMITTER_EMAIL": "341338700+zanvd-claude[bot]@users.noreply.github.com",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_CONFIG_COUNT": "7",
    "GIT_CONFIG_KEY_0": "commit.gpgsign",
    "GIT_CONFIG_VALUE_0": "false",
    "GIT_CONFIG_KEY_1": "tag.gpgsign",
    "GIT_CONFIG_VALUE_1": "false",
    "GIT_CONFIG_KEY_2": "user.signingkey",
    "GIT_CONFIG_VALUE_2": "",
    "GIT_CONFIG_KEY_3": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_3": "git@github.com:",
    "GIT_CONFIG_KEY_4": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_4": "",
    "GIT_CONFIG_KEY_5": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_5": "!~/.local/bin/claude-gh/git-credential",
    "GIT_CONFIG_KEY_6": "core.sshCommand",
    "GIT_CONFIG_VALUE_6": "false"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_ENV_FILE\" ]; then echo 'export PATH=\"$HOME/.local/bin/claude-gh/shim:$PATH\"' >> \"$CLAUDE_ENV_FILE\"; fi"
          }
        ]
      }
    ]
  }
}
